# build/configs/kernel-config.x86_64  (HARDENED Daft-Kernel fragment)
#
# This is a KSPP-aligned hardening fragment, NOT a rootkit config.
# Apply on top of a base defconfig:  scripts/kconfig/merge_config.sh \
#   arch/x86/configs/x86_64_defconfig build/configs/kernel-config.x86_64
#
# Defensive posture: make the kernel resistant to the very primitives the
# original spec described (DKOM, covert channels, unauthorized memory patching).
CONFIG_CC_STACKPROTECTOR_STRONG=y
CONFIG_STACKPROTECTOR=y
CONFIG_SLUB_DEBUG=y
CONFIG_PAGE_POISONING=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL=y
CONFIG_GCC_PLUGIN_RANDSTRUCT=y
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
# MODULE_SIG_FORCE deliberately NOT set: forced signature enforcement breaks
# NVIDIA DKMS (out-of-tree drivers cannot ship our private key). Our own
# modules (daft-defmon) are still signed at build time via MODULE_SIG_ALL,
# and LOCK_DOWN_KERNEL_FORCE_INTEGRITY keeps the tamper posture elsewhere.
# CONFIG_MODULE_SIG_FORCE is not set
# Live, unauthorized memory patching (e.g. via /dev/kmem) is DISABLED:
CONFIG_DEVKMEM=n
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y
# Covert-channel / raw hidden sockets remain available ONLY via explicit,
# logged, root-gated LSM policy — not silently. See docs/ARCHITECTURE.md.
#
# ── Live-system essentials ─────────────────────────────────────────────
# live-boot mounts squashfs+overlay from CD/USB very early. These must be
# builtin (=y): initramfs hooks cannot copy what is not a module, and a
# missing driver here means an unbootable ISO, not a graceful fallback.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CP437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_USB_STORAGE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
#
# ── GPU enablement (AMD RDNA/CDNA + NVIDIA GSP-class) ──────────────────
# Target cards: RTX 3090/4090/5090 (GA102/AD102/GB202), RX 7900 XTX
# (Navi31/gfx1100), MI200/MI300 (gfx90a/gfx942). Drivers probe at boot,
# so building them in costs nothing on machines without the hardware.
CONFIG_DRM=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_AMDGPU=m
# Legacy ladder, oldest first:
#   pre-GCN (HD 2000-6000)      -> radeon
#   GCN1 / Southern Islands     -> amdgpu SI (R9 270X/280X...)
CONFIG_DRM_AMDGPU_SI=y
#   GCN2 / Sea Islands          -> amdgpu CIK (experimental tier)
CONFIG_DRM_AMDGPU_CIK=y
#   GCN4-5 (RX 400-500, Vega)   -> amdgpu native
#   RDNA1/2/3 (RX 5000/6000/7000) -> amdgpu + DCN
#   RDNA4 (RX 9000)             -> amdgpu + DCN (needs recent kernel + fw)
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_SI=y
# KFD/HSA kernel driver — REQUIRED by ROCm userland (rocminfo, HIP).
# Resolves to =m when AMDGPU=m; the compat checker accepts both.
CONFIG_HSA_AMD=y
# Unified-memory primitives (UVM-class). HMM_MIRROR is the seam our
# accel_hal / Heterogeneous Memory Manager ports through.
CONFIG_MMU_NOTIFIER=y
CONFIG_HMM_MIRROR=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
# Hotplug enables ZONE_DEVICE device-memory zones on x86_64.
CONFIG_MEMORY_HOTPLUG=y
# Huge pages help GPUVM; PASID/PRI for compute DMA isolation.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_PCI_PASID=y
CONFIG_PCI_PRI=y
# IOMMU: real-GPU DMA isolation (+ future IOMMU binding in accel_hal).
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_IRQ_REMAP=y
# Nouveau keeps pre-Turing cards alive without DKMS; Blackwell-class
# RTX 50xx needs the out-of-tree open modules (shipped via daft specs).
CONFIG_DRM_NOUVEAU=m
# Virtual GPU so QEMU-based CI can exercise real KMS/DRM paths.
CONFIG_DRM_VIRTIO_GPU=m
