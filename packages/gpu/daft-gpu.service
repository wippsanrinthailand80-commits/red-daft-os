[Unit]
Description=Red Daft GPU compatibility manager
# After modules-load.d (daft-defmon) and basic PCI enumeration.
After=systemd-modules-load.service systemd-udev-trigger.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/daft-gpu activate-auto
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
