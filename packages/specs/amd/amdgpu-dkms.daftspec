#!/usr/bin/env bash
# amdgpu-dkms.daftspec — AMDGPU kernel driver (DKMS) for Red Daft OS.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=amd-common.sh
source "$HERE/amd-common.sh"
DEBS=(amdgpu-dkms amdgpu-lib libdrm-amdgpu-amdgpu1)
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
ROOT="$WORK/rootfs"; mkdir -p "$ROOT"
add_amd_repo "$ROOT"
if [[ "${1:-}" == "check" ]]; then check_debs "$WORK" "${DEBS[@]}";
else stage_debs "$ROOT" "${DEBS[@]}"; build_daft "$WORK" amdgpu-dkms "$ROCM_VER"; fi
