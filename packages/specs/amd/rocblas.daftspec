#!/usr/bin/env bash
# rocblas.daftspec — ROCm BLAS (rocBLAS) math library.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=amd-common.sh
source "$HERE/amd-common.sh"
DEBS=(rocblas rocblas-dev rocm-libs)
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
ROOT="$WORK/rootfs"; mkdir -p "$ROOT"
add_amd_repo "$ROOT"
if [[ "${1:-}" == "check" ]]; then check_debs "$WORK" "${DEBS[@]}";
else stage_debs "$ROOT" "${DEBS[@]}"; build_daft "$WORK" rocblas "$ROCM_VER"; fi
