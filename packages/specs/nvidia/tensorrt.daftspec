#!/usr/bin/env bash
# tensorrt.daftspec — TensorRT (inference optimizer) for Red Daft OS.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=nvidia-common.sh
source "$HERE/nvidia-common.sh"
DEBS=(tensorrt tensorrt-dev tensorrt-libs libnvinfer-dev)
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
ROOT="$WORK/rootfs"; mkdir -p "$ROOT"
add_nvidia_repo "$ROOT"
if [[ "${1:-}" == "check" ]]; then check_debs "$WORK" "${DEBS[@]}";
else stage_debs "$ROOT" "${DEBS[@]}"; build_daft "$WORK" tensorrt "$CUDA_VER"; fi
