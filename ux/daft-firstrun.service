# ux/daft-firstrun.service — show the Classified ID Card on first boot only.
[Unit]
Description=Red Daft OS first-run Classified ID Card
ConditionFirstBoot=yes
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/daft/ux/firstrun-idcard.sh
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
